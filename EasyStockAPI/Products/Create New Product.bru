meta {
  name: Create New Product
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/products/create
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name":"Ball",
    "price": 5.99,
    "stockQuantity": 35,
    "minQuantity": 5,
    "categoryId": 3
  }
}

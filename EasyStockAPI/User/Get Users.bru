meta {
  name: Get Users
  type: http
  seq: 3
}

get {
  url: http://localhost:8080/api/users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "email":"luan@example.com",
    "password":"password123"
  }
}

vars:post-response {
  accessToken: res.body.accessToken
}
